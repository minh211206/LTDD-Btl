<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5EFE6">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF4E2C0E"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HỆ THỐNG ADMIN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý toàn bộ cửa hàng"
            android:textSize="13sp"
            android:textColor="#CCFFFFFF" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp" android:gravity="center">
                        <TextView android:id="@+id/tv_stat_products"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="24sp" android:textStyle="bold" android:textColor="#4E2C0E" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Đồ uống" android:textSize="11sp" android:textColor="#9E9E9E" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp" android:gravity="center">
                        <TextView android:id="@+id/tv_stat_orders"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="24sp" android:textStyle="bold" android:textColor="#1565C0" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Đơn hàng" android:textSize="11sp" android:textColor="#9E9E9E" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp" android:gravity="center">
                        <TextView android:id="@+id/tv_stat_users"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="24sp" android:textStyle="bold" android:textColor="#2E7D32" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Người dùng" android:textSize="11sp" android:textColor="#9E9E9E" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Menu cards -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_admin_icon_purple" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_coffee_cup" android:contentDescription="Do uong" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quản lý đồ uống" android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Thêm, sửa, xóa món" android:textSize="12sp" android:textColor="#9E9E9E" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/tint_chevron" android:contentDescription="Mo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_admin_icon_blue" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_receipt" android:contentDescription="Don hang" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quản lý đơn hàng" android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Xem và cập nhật trạng thái" android:textSize="12sp" android:textColor="#9E9E9E" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/tint_chevron" android:contentDescription="Mo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_inventory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_admin_icon_orange" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_edit" android:contentDescription="Ton kho" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quản lý tồn kho" android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Cập nhật số lượng nguyên liệu" android:textSize="12sp" android:textColor="#9E9E9E" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/tint_chevron" android:contentDescription="Mo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_admin_icon_green" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_person" android:contentDescription="Nguoi dung" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Quản lý người dùng" android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Xem và chỉnh sửa tài khoản" android:textSize="12sp" android:textColor="#9E9E9E" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/tint_chevron" android:contentDescription="Mo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Logout -->
    <LinearLayout
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        android:foreground="?attr/selectableItemBackground">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_logout" app:tint="@color/tint_red" android:contentDescription="Dang xuat" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="Đăng xuất"
            android:textSize="15sp" android:textColor="#E53935" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
